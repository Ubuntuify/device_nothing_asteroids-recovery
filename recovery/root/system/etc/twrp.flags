# Mount point     fstype      device          device2                     flags

# Logical partitions
#
/system_ext       ext4        system_ext                                  flags=display=System_EXT;logical
/system_dlkm      ext4        system_dlkm                                 flags=display=System_DLKM;logical
/vendor_dlkm      ext4        vendor_dlkm                                 flags=display=Vendor_DLKM;logical

# Userdata/metadata partitions
/metadata         f2fs        /dev/block/by-name/metadata                 flags=display="Metadata";backup=1;wrappedkey

# Boot partitions
/boot             emmc        /dev/block/bootdevice/by-name/boot          flags=slotselect
/init_boot        emmc        /dev/block/bootdevice/by-name/init_boot     flags=slotselect;display="Init Boot";backup=1;flashimg=1
/vendor_boot      emmc        /dev/block/bootdevice/by-name/vendor_boot   flags=slotselect;display="Vendor Boot";backup=1;flashimg=1;
/recovery         emmc        /dev/block/bootdevice/by-name/recovery      flags=slotselect;display="Recovery";backup=1;flashimg=1

# Miscellaneous partitions
/misc             emmc        /dev/block/bootdevice/by-name/misc
/frp              emmc        /dev/block/bootdevice/by-name/frp

# AVB partitions
/dtbo             emmc        /dev/block/bootdevice/by-name/dtbo          flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta           emmc        /dev/block/bootdevice/by-name/vbmeta        flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system    emmc        /dev/block/bootdevice/by-name/vbmeta_system flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor    emmc        /dev/block/bootdevice/by-name/vbmeta_vendor flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1

# Persist partitions
/persist          ext4        /dev/block/bootdevice/by-name/persist       flags=display="Persist";backup=0
/persist_image    emmc        /dev/block/bootdevice/by-name/persist       flags=display="Persist";flashimg=1;backup=1

# Modem partitions
/modem            vfat        /dev/block/bootdevice/by-name/modem         flags=display="Modem";slotselect;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait"
/modem            emmc        /dev/block/bootdevice/by-name/modem         flags=display="Modem";slotselect;backup=1;flashimg=1
/dsp              ext4        /dev/block/bootdevice/by-name/dsp           flags=display="DSP";slotselect;fsflags="ro"
/dsp_image        emmc        /dev/block/bootdevice/by-name/dsp           flags=display="DSP";slotselect;backup=1

# UEFI partitions (not applicable???) TODO: investigate this
/logfs            vfat        /dev/block/bootdevice/by-name/logfs         flags=display="LogFS (UEFI)";fsflags="umask=006,uid=1000,gid=1000,utf8"

# TODO: COMPLETE THIS

# Removable partitions
/storage       	  auto        /data/media/0                  		          flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable
/usb_otg               auto   /dev/block/sdg1   /dev/block/sdg            flags=display="USB Storage";fsflags="utf8,sync";storage;formattable;removable
